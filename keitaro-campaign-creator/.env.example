# Корень вашего Keitaro (без /admin_api/v1)
KEITARO_URL=https://your-tracker.example.com
# Профиль -> API ключи в админке Keitaro
KEITARO_API_KEY=

# Предпочтительные домен, группа и источник (значения из тестового задания).
# Если таких нет в Keitaro или значение пустое, берётся первая подходящая запись из API Keitaro.
KEITARO_DOMAIN=in.posdk.xyz
KEITARO_GROUP=FORTESTS
KEITARO_SOURCE=FORTESTS
REDIRECT_URL=https://google.com

# Необязательно
# DATABASE_URL=sqlite:///./app.db
# OFFERS_TTL_SECONDS=600
# KEITARO_TIMEOUT=20
